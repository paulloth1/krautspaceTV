# Install: sudo cp deploy/kiosk.service /etc/systemd/system/ && sudo systemctl enable --now kiosk.service (xinitrc must also be present at /home/admin/signage/deploy/xinitrc on the Pi)
[Unit]
Description=Signage kiosk X session (chromium)
Requires=network-online.target
Wants=backend.service
After=backend.service network-online.target getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=admin
Environment=XDG_RUNTIME_DIR=/run/user/1000
WorkingDirectory=/home/admin/signage
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do curl -sf http://127.0.0.1:8081/display >/dev/null && exit 0; sleep 1; done; exit 1'
# Release plymouth's hold on the display (but keep its last frame drawn)
# before Xorg starts, not after: Xorg grabs DRM master as soon as it starts,
# and doing this from xinitrc instead (which only runs once Xorg is already
# up) meant Xorg sometimes had to contend with plymouthd for the display,
# occasionally dumping its own startup log to the screen.
ExecStartPre=-/usr/bin/plymouth quit --retain-splash
ExecStart=/usr/bin/startx /home/admin/signage/deploy/xinitrc -- :0 vt1
Restart=on-failure
RestartSec=5
TTYPath=/dev/tty1
StandardInput=tty

[Install]
WantedBy=multi-user.target
