# Install: sudo cp deploy/backend-tls-443.service /etc/systemd/system/ && sudo systemctl enable --now backend-tls-443.service
[Unit]
Description=Signage FastAPI backend (uvicorn, HTTPS on standard port 443)
Wants=network-online.target
After=network-online.target backend.service

[Service]
Type=simple
User=admin
AmbientCapabilities=CAP_NET_BIND_SERVICE
WorkingDirectory=/home/admin/signage
ExecStart=/home/admin/signage-venv/bin/uvicorn backend.app:app --host 0.0.0.0 --port 443 --ssl-keyfile certs/key.pem --ssl-certfile certs/cert.pem
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
