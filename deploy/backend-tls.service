# Install: sudo cp deploy/backend-tls.service /etc/systemd/system/ && sudo systemctl enable --now backend-tls.service
[Unit]
Description=Signage FastAPI backend (uvicorn, HTTPS for LAN/admin access)
Wants=network-online.target
After=network-online.target backend.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/signage
ExecStart=/home/admin/signage-venv/bin/uvicorn backend.app:app --host 0.0.0.0 --port 8080 --ssl-keyfile certs/key.pem --ssl-certfile certs/cert.pem
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
